---
import Layout from '../layouts/Layout.astro';

const populations = [
  {
    title: "Children & Preteens (5+)",
    subtitle: "Safety, Play, and Expression",
    desc: "For kids, therapy is playful, creative, and grounded in safety. We might talk, draw, move, or use sensory tools to help them express what’s going on inside.",
    items: ["Big feelings & meltdowns", "School or peer struggles", "Grief or scary experiences", "Adoption, foster care, and family transitions"],
    icon: "🧸"
  },
  {
    title: "Teens & Young Adults",
    subtitle: "Finding Your Voice",
    desc: "Many teens and young adults show up carrying anxiety, people-pleasing, or a loud inner critic. We work together to untangle where those patterns started and what you want next.",
    items: ["Anxiety, depression, and burnout", "Identity, relationships, and family conflict", "Trauma and PTSD", "School, work, and life transitions"],
    icon: "🎧"
  },
  {
    title: "Parents, Caregivers & Families",
    subtitle: "Restoring Connection",
    desc: "Parenting is hard; parenting kids with trauma, neurodivergence, or complex behavior can feel impossible. We focus on connection, practical tools, and care for you as a person.",
    items: ["Adoption and post-adoption support", "Behavioral and attachment challenges", "Co-parenting and family communication", "Support for exhausted caregivers"],
    icon: "🏡"
  }
];

const themes = [
  { title: "Emotional Health", items: ["Anxiety, panic, or chronic worry", "Trauma, PTSD, or dissociation", "Depression or numbness", "Grief and complicated family stories"] },
  { title: "Identity & Belonging", items: ["Gender and sexuality", "Faith shifts", "Neurodiversity", "Perfectionism and boundaries"] },
  { title: "Family Life", items: ["Kids with big behaviors", "Co-parenting", "Adoption and foster care", "Caregiver burnout"] }
];
---

<Layout title="Services | Mountains to Sea Therapy">
  <!-- Hero -->
  <section class="relative pt-32 pb-20 bg-brand-primary text-white overflow-hidden">
    <div class="absolute inset-0 bg-brand-dark/10"></div>
    <div class="max-w-7xl mx-auto px-4 relative z-10 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold mb-6">Who I Work With</h1>
      <p class="text-xl max-w-2xl mx-auto text-brand-light/90">
        Therapy is tailored to the person or family in front of me.
      </p>
    </div>
  </section>

  <!-- Populations Grid -->
  <section class="py-24 max-w-7xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8">
      {populations.map((pop) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="w-14 h-14 bg-brand-surface rounded-full flex items-center justify-center text-3xl mb-6 group-hover:bg-brand-primary/10 transition-colors">
            {pop.icon}
          </div>
          <h2 class="text-2xl font-display font-bold text-brand-dark mb-1">{pop.title}</h2>
          <span class="text-xs font-bold text-brand-secondary uppercase tracking-widest mb-4">{pop.subtitle}</span>
          <p class="text-gray-600 mb-8 leading-relaxed flex-grow">
            {pop.desc}
          </p>
          <ul class="space-y-3 pt-6 border-t border-gray-100">
            {pop.items.map(item => (
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <span class="text-brand-primary">●</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Specialties Section -->
  <section class="py-24 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-display font-bold text-brand-dark mb-6">Respectful, Whole-Person Care</h2>
          <div class="prose prose-lg text-gray-600">
            <p class="mb-6">
              Therapy here considers the whole picture: your relationships, identity, culture, faith background, family system, sensory needs, and lived experience.
            </p>
            <p class="font-bold text-brand-primary italic text-xl">
              "You don’t have to explain your whole life perfectly before we can begin. We’ll make sense of it together."
            </p>
          </div>
          
          <div class="mt-10 flex flex-wrap gap-3">
             {['Child & Teen Therapy', 'Parenting Support', 'Adoption & Foster Care', 'Trauma & PTSD', 'Anxiety & Depression', 'Family Systems', 'Sensory-Aware Care'].map(tag => (
               <span class="bg-white border border-brand-primary/20 text-brand-primary px-4 py-2 rounded-full text-sm font-semibold">
                 {tag}
               </span>
             ))}
          </div>
        </div>
        
        <div class="grid grid-cols-1 gap-6">
          {themes.map(theme => (
             <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
               <h3 class="font-display font-bold text-xl text-brand-dark mb-4 border-b border-gray-100 pb-2">{theme.title}</h3>
               <div class="flex flex-wrap gap-2">
                 {theme.items.map(item => (
                   <span class="text-sm text-gray-500 bg-brand-surface px-2 py-1 rounded">
                     {item}
                   </span>
                 ))}
               </div>
             </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <section class="py-24 bg-brand-primary text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">Ready to get started?</h2>
      <p class="text-brand-light/90 text-lg mb-8">
        You set the goals, and we co-create the path. With consent, I can collaborate with schools, physicians, and other members of your care team.
      </p>
      <a href="/contact" class="inline-block bg-brand-secondary text-brand-dark font-bold px-8 py-4 rounded-full shadow-lg hover:shadow-xl hover:bg-white transition-all transform hover:-translate-y-1">
        Schedule a Consult
      </a>
    </div>
  </section>
</Layout>
